audios/**/*.mp4
audios/**/*.webm
audios/**/*.opus
audios/**/*.part
audios/**/*.f*.m4a
audios/**/*.f*.mp4

# yt-dlp sidecar metadata (bulk). The small catalog CSVs are tracked instead.
metadata/**/*.info.json
*.info.json

